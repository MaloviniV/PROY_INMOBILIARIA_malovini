@model PropietarioModel

<div class="container mt-4">
  <div class="row">
    <div class="col-md-8 offset-md-2">
      <h1>Crear Propietario</h1>

      <hr />

      <form asp-action="Create" method="post">
        <div class="mb-3">
          <label asp-for="Persona.Nombre" class="form-label">Nombre</label>
          <input asp-for="Persona.Nombre" class="form-control" placeholder="Ingrese el nombre" />
          <span asp-validation-for="Persona.Nombre" class="text-danger"></span>
        </div>

        <div class="mb-3">
          <label asp-for="Persona.Apellido" class="form-label">Apellido</label>
          <input asp-for="Persona.Apellido" class="form-control" placeholder="Ingrese el apellido" />
          <span asp-validation-for="Persona.Apellido" class="text-danger"></span>
        </div>

        <div class="mb-3">
          <label asp-for="Persona.Dni" class="form-label">DNI</label>
          <input asp-for="Persona.Dni" class="form-control" placeholder="Ingrese el DNI" />
          <span asp-validation-for="Persona.Dni" class="text-danger"></span>
        </div>

        <div class="mb-3">
          <label asp-for="Persona.Telefono" class="form-label">Teléfono</label>
          <input asp-for="Persona.Telefono" class="form-control" placeholder="Ingrese el teléfono" />
          <span asp-validation-for="Persona.Telefono" class="text-danger"></span>
        </div>

        <div class="mb-3">
          <label asp-for="Persona.Mail" class="form-label">Email</label>
          <input asp-for="Persona.Mail" class="form-control" placeholder="Ingrese el email" />
          <span asp-validation-for="Persona.Mail" class="text-danger"></span>
        </div>

        <div class="mb-3">
          <label asp-for="Persona.Direccion" class="form-label">Dirección</label>
          <input asp-for="Persona.Direccion" class="form-control" placeholder="Ingrese la dirección" />
          <span asp-validation-for="Persona.Direccion" class="text-danger"></span>
        </div>

        <div class="mb-3">
          <label asp-for="Cbu" class="form-label">CBU</label>
          <input asp-for="Cbu" type="text" class="form-control" placeholder="Ingrese el CBU" maxlength="22"
                 inputmode="numeric" autocomplete="off" />
          <span asp-validation-for="Cbu" class="text-danger"></span>
        </div>

        <div class="mb-3">
          <label asp-for="Cuit" class="form-label">CUIT</label>
          <input asp-for="Cuit" type="text" class="form-control" placeholder="Ingrese el CUIT" maxlength="11"
                 inputmode="numeric" autocomplete="off" />
          <span asp-validation-for="Cuit" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-circle"></i> Guardar
          </button>
          <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Volver
          </a>
        </div>
      </form>
    </div>
  </div>
</div>

@section Scripts {
  @{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
  }
}
