@model ReservaModel
<div class="mb-3"><label asp-for="IdInquilino" class="form-label">Inquilino</label><select asp-for="IdInquilino"
                                                                                           asp-items="ViewBag.Inquilinos" class="form-select">
  <option value="0">Seleccione un inquilino</option>
</select><span asp-validation-for="IdInquilino" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="IdInmueble" class="form-label">Inmueble</label><select asp-for="IdInmueble"
                                                                                         asp-items="ViewBag.Inmuebles" class="form-select">
  <option value="0">Seleccione un inmueble</option>
</select><span asp-validation-for="IdInmueble" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="FechaDesde" class="form-label">Fecha desde</label><input asp-for="FechaDesde"
                                                                                             type="date" class="form-control" /><span asp-validation-for="FechaDesde" class="text-danger"></span></div>
  <div class="mb-3"><label asp-for="FechaHasta" class="form-label">Fecha hasta</label><input asp-for="FechaHasta"
                                                                                               type="date" class="form-control" /><span asp-validation-for="FechaHasta" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Monto" class="form-label">Monto</label><input asp-for="Monto" type="number"
                                                                                      step="0.01" class="form-control" /><span asp-validation-for="Monto" class="text-danger"></span></div>