@model IList<ReservaModel>
@{
  ViewData["Title"] = "Reservas";
}
<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@ViewData["Title"]</h1><a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nueva
    reserva</a>
  </div>
  @if (TempData["SuccessMessage"] is not null)
  {
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
  }
  @if (Model.Count == 0)
  {
    <div class="alert alert-info">No hay reservas registradas.</div>
  }
  else
  {

    <div
      class="table-responsive">
      <table class="table table-striped table-hover">
        <thead class="table-dark">
          <tr>
            <th>ID</th>
            <th>Inquilino</th>
            <th>Inmueble</th>
            <th>Desde</th>
            <th>Hasta</th>
            <th>Monto</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var item in Model)
          {
            <tr>
              <td>@item.Id</td>
              <td>@item.Inquilino</td>
              <td>@item.DireccionInmueble</td>
              <td>@item.FechaDesde.ToString("dd/MM/yyyy")</td>
              <td>@item.FechaHasta.ToString("dd/MM/yyyy")</td>
              <td>@item.Monto.ToString("C")</td>
              <td><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Ver</a> <a asp-action="Edit"
                                                                                                           asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"><button
                  class="btn btn-sm btn-danger" onclick="return confirm('¿Eliminar esta reserva?')">Eliminar</button>
                </form>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
</div>