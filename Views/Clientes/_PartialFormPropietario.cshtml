@model PropietarioModel

<section class="border rounded p-2 shadow-sm bg-body">
  <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-2">
    <h3 class="h5 mb-0">Datos del propietario</h3>
    <div class="d-flex flex-wrap justify-content-start justify-content-sm-end gap-2">
      <button v-if="!editando('propietario')" type="button" class="btn btn-sm btn-outline-primary"
        @@click="iniciarEdicion('propietario')">
        <i class="bi bi-pencil"></i> Editar
      </button>
      <template v-else>
        <button type="button" class="btn btn-sm btn-primary" @@click="guardarSeccion('propietario')">
          <i class="bi bi-check2"></i> Guardar
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" @@click="cancelarEdicion('propietario')">
          Cancelar
        </button>
      </template>
    </div>
  </div>
  <hr class="my-2" />

  <input asp-for="IdPersona" type="hidden" />

  <div class="row g-2">
    <div class="col-md-6">
      <label asp-for="Cbu" class="form-label">CBU</label>
      <input asp-for="Cbu" class="form-control" :readonly="!editando('propietario')" />
      <span asp-validation-for="Cbu" class="text-danger"></span>
    </div>

    <div class="col-md-6">
      <label asp-for="Cuit" class="form-label">CUIT</label>
      <input asp-for="Cuit" class="form-control" :readonly="!editando('propietario')" />
      <span asp-validation-for="Cuit" class="text-danger"></span>
    </div>
  </div>
</section>
