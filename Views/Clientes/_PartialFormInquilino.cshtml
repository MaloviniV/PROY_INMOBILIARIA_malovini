@model ClienteManagerViewModel

@{
  bool esLectura = Model.Modo == "lectura";
}

<section class="manager-section role-data-section border rounded p-2" data-seccion="inquilino">
  <div class="manager-section-heading">
    <h3 class="h5 mb-0">Datos del inquilino</h3>
    <div class="manager-section-actions">
      <button v-if="modoLectura || seccionEditando !== 'inquilino'" type="button" class="btn btn-sm btn-outline-primary"
        @@click="iniciarEdicion('inquilino')">
        <i class="bi bi-pencil"></i> Editar
      </button>
      <template v-else>
        <button type="button" class="btn btn-sm btn-primary" @@click="guardarSeccion('inquilino')">
          <i class="bi bi-check2"></i> Guardar
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" @@click="cancelarEdicion('inquilino')">
          Cancelar
        </button>
      </template>
    </div>
  </div>
  <hr class="manager-section-divider" />

  <input asp-for="Inquilino.IdPersona" type="hidden" />

  <div class="row g-2">
    <div class="col-md-6">
      <label asp-for="Inquilino.IngresosAproximados" class="form-label">Ingresos aproximados</label>
      <input asp-for="Inquilino.IngresosAproximados" type="number" min="0" step="0.01" class="form-control"
             :readonly="modoLectura || seccionEditando !== 'inquilino'" />
      <span asp-validation-for="Inquilino.IngresosAproximados" class="text-danger"></span>
    </div>

    <div class="col-md-6">
      <label asp-for="Inquilino.Profesion" class="form-label">Profesion</label>
      <input asp-for="Inquilino.Profesion" class="form-control"
             :readonly="modoLectura || seccionEditando !== 'inquilino'" />
      <span asp-validation-for="Inquilino.Profesion" class="text-danger"></span>
    </div>
  </div>
</section>
