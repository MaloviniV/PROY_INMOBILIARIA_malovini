@model InquilinoModel

<section class="border rounded p-2 shadow-sm bg-body">
  <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-2">
    <h3 class="h5 mb-0">Datos del inquilino</h3>
    <div class="d-flex flex-wrap justify-content-start justify-content-sm-end gap-2">
      <button v-if="!editando('inquilino')" type="button" class="btn btn-sm btn-outline-primary"
        @@click="iniciarEdicion('inquilino')">
        <i class="bi bi-pencil"></i> Editar
      </button>
      <template v-else>
        <button type="button" class="btn btn-sm btn-primary" @@click="guardarSeccion('inquilino')">
          <i class="bi bi-check2"></i> Guardar
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" @@click="cancelarEdicion('inquilino')">
          Cancelar
        </button>
      </template>
    </div>
  </div>
  <hr class="my-2" />

  <input asp-for="IdPersona" type="hidden" />

  <div class="row g-2">
    <div class="col-md-6">
      <label asp-for="IngresosAproximados" class="form-label">Ingresos aproximados</label>
      <input asp-for="IngresosAproximados" type="number" min="0" step="0.01" class="form-control"
             :readonly="!editando('inquilino')" />
      <span asp-validation-for="IngresosAproximados" class="text-danger"></span>
    </div>

    <div class="col-md-6">
      <label asp-for="Profesion" class="form-label">Profesion</label>
      <input asp-for="Profesion" class="form-control" :readonly="!editando('inquilino')" />
      <span asp-validation-for="Profesion" class="text-danger"></span>
    </div>
  </div>
</section>
