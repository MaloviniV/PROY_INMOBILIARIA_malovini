@model ClienteManagerViewModel

@{
  bool tienePropietario = Model.Propietario is not null;
  bool tieneInquilino = Model.Inquilino is not null;
  bool esCrear = Model.Modo == "crear";
  bool esLectura = Model.Modo == "lectura";
  ViewData["Title"] = esCrear ? "Crear Cliente" : esLectura ? "Detalle del Cliente" : "Editar Cliente";
}

<div id="app" class="container mt-4" data-modo="@Model.Modo" data-tiene-propietario="@tienePropietario"
     data-tiene-inquilino="@tieneInquilino" v-cloak>
  @*ENCABEZADO*@
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-1 text-success">GESTIONAR CLIENTE</h2>

    <a asp-action="Index" class="btn btn-success">
      <i class="bi bi-arrow-left"></i> Volver al Listado
    </a>
  </div>
  @*DATOS*@
  <div class="row g-4 align-items-start">
    @*DATOS PERSONALES*@
    <div class="col-lg-4">
      <form method="post" asp-action="GuardarPersona" ref="form-persona">
        @Html.AntiForgeryToken()
        <partial name="_PartialFormPersona" model="Model.Persona" />
      </form>
    </div>

    @*DATOS ROLES*@
    <div class="col-lg-8">
      <section class="border rounded p-3 shadow-sm bg-body">
        @*ENCABEZADO*@
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h3 class="h5 mb-0">Roles del cliente</h3>
        </div>
        @*NAV PESTAÑAS DE ROLES*@
        <ul class="nav nav-tabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button type="button" class="nav-link" :class="classActive(`propietario`)"
              @@click="rolActivo = 'propietario'" role="tab">
              Propietario
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button type="button" class="nav-link" :class="classActive(`inquilino`)" @@click="rolActivo = 'inquilino'"
                    role="tab">
              Inquilino
            </button>
          </li>
        </ul>
        @*INFO PROPIETARIOS/INQUILINOS*@
        <div class="pt-3">
          @*INFO PROPIETARIO*@
          <div v-show="rolActivo === 'propietario'" class="role-tab-content">
            <div v-if="!(tienePropietario || seccionEditando === `propietario`)" class="alert alert-info">
              <button type="button" class="btn btn-primary" @@click="iniciarEdicion(`propietario`)">
                + Registrar como Propietario
              </button>
            </div>
            <div v-else>
              <form method="post" asp-action="GuardarPropietario" ref="form-propietario">
                @Html.AntiForgeryToken()
                <input asp-for="Persona.Id" type="hidden" />
                <input asp-for="Persona.Dni" type="hidden" />
                <partial name="_PartialFormPropietario" model="Model.Propietario" />
              </form>

              @*TABLA PARA LISTAR INMUEBLES DEL PROPIETARIO*@
              <section v-if="tienePropietario" class="mt-3">
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                  <h4 class="h6 mb-0">Inmuebles del propietario</h4>
                  <a asp-controller="Inmuebles" asp-action="Create" asp-route-propietarioId="@Model.Persona.Id"
                     class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-plus-lg"></i> Agregar inmueble
                  </a>
                </div>

                @if (Model.InmueblesPropietario.Count == 0)
                {
                  <p class="text-body-secondary small mb-0">Este propietario todavía no tiene inmuebles registrados.</p>
                }
                else
                {
                  <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                      <thead>
                        <tr>
                          <th>Dirección</th>
                          <th>Tipo</th>
                          <th>Precio</th>
                          <th>Estado</th>
                        </tr>
                      </thead>
                      <tbody>
                        @foreach (InmuebleModel inmueble in Model.InmueblesPropietario)
                        {
                          <tr>
                            <td>@inmueble.Direccion</td>
                            <td>@(inmueble.NombreTipo ?? "Sin tipo")</td>
                            <td>@inmueble.Precio.ToString(format: "C2")</td>
                            <td>
                              <span
                              class="d-inline-block rounded-circle p-1 me-1 @(inmueble.Estado ? "bg-success" : "bg-secondary")"
                              aria-hidden="true"></span>
                              @(inmueble.Estado ? "Disponible" : "No disponible")
                            </td>
                          </tr>
                        }
                      </tbody>
                    </table>
                  </div>
                }
              </section>
              <div v-else class="alert alert-danger" role="alert">
                Debe cargar los datos del Propietario
              </div>
            </div>
          </div>
          @*INFO INQUILINO*@
          <div v-show="rolActivo === 'inquilino'" class="role-tab-content">
            <div v-if="!(tieneInquilino || seccionEditando === `inquilino`)" class="alert alert-info">
              <button type="button" class="btn btn-primary" @@click="iniciarEdicion(`inquilino`)">
                + Registrar como Inquilino
              </button>
            </div>
            <div v-else>
              <form method="post" asp-action="GuardarInquilino" ref="form-inquilino">
                @Html.AntiForgeryToken()
                <input asp-for="Persona.Id" type="hidden" />
                <input asp-for="Persona.Dni" type="hidden" />
                <partial name="_PartialFormInquilino" model="Model.Inquilino" />
              </form>

              <section v-if="tieneInquilino" class="mt-3">
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                  <h4 class="h6 mb-0">Alquileres del inquilino</h4>
                  <a asp-controller="Reservas" asp-action="Create" asp-route-inquilinoId="@Model.Persona.Id"
                     class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-plus-lg"></i> Agregar reserva/alquiler
                  </a>
                </div>

                @if (Model.AlquileresInquilino.Count == 0)
                {
                  <p class="text-body-secondary small mb-0">Este inquilino todavía no tiene alquileres registrados.</p>
                }
                else
                {
                  <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                      <thead>
                        <tr>
                          <th>Inmueble</th>
                          <th>Desde</th>
                          <th>Hasta</th>
                          <th>Monto</th>
                        </tr>
                      </thead>
                      <tbody>
                        @foreach (var alquiler in Model.AlquileresInquilino)
                        {
                          <tr>
                            <td>@(alquiler.DireccionInmueble ?? "Sin dirección")</td>
                            <td>@alquiler.FechaDesde.ToString("dd/MM/yyyy")</td>
                            <td>@alquiler.FechaHasta.ToString("dd/MM/yyyy")</td>
                            <td>@alquiler.Monto.ToString("C2")</td>
                          </tr>
                        }
                      </tbody>
                    </table>
                  </div>
                }
              </section>
              <div v-else class="alert alert-danger" role="alert">
                Debe cargar los datos del inquilino
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</div>

<style>
  [v-cloak] {
    display: none;
  }
</style>

@section Scripts {
  <script src="/js/Manager.js"></script>
}