@model InmuebleModel
@{
  ViewData["Title"] = "Detalle del inmueble";
}
<div class="container mt-4">
  <h1>@ViewData["Title"]</h1>
  <dl class="row">
    <dt class="col-sm-3">Dirección</dt>
    <dd class="col-sm-9">@Model.Direccion</dd>
    <dt class="col-sm-3">Tipo</dt>
    <dd class="col-sm-9">@Model.NombreTipo</dd>
    <dt class="col-sm-3">Propietario</dt>
    <dd class="col-sm-9">@Model.NombrePropietario</dd>
    <dt class="col-sm-3">Cupo</dt>
    <dd class="col-sm-9">@Model.Cupo</dd>
    <dt class="col-sm-3">Precio</dt>
    <dd class="col-sm-9">@Model.Precio.ToString("C")</dd>
    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">@(Model.Estado ? "Disponible" : "No disponible")</dd>
  </dl><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a> <a asp-action="Index"
                                                                                           class="btn btn-secondary">Volver</a>
</div>