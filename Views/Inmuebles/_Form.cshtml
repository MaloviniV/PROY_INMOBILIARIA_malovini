@model InmuebleModel
<div class="mb-3"><label asp-for="Direccion" class="form-label">Dirección</label><input asp-for="Direccion"
                                                                                          class="form-control" /><span asp-validation-for="Direccion" class="text-danger"></span></div>
  <div class="mb-3"><label asp-for="ImgPortada" class="form-label">Imagen (URL)</label><input asp-for="ImgPortada"
                                                                                                class="form-control" /></div>
    <div class="mb-3"><label asp-for="Cupo" class="form-label">Cupo</label><input asp-for="Cupo" type="number"
                                                                                    class="form-control" /><span asp-validation-for="Cupo" class="text-danger"></span></div>
      <div class="mb-3"><label asp-for="Precio" class="form-label">Precio</label><input asp-for="Precio" type="number"
                                                                                          step="0.01" class="form-control" /><span asp-validation-for="Precio" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="IdPropietario" class="form-label">Propietario</label><select asp-for="IdPropietario"
                                                                                                       asp-items="ViewBag.Propietarios" class="form-select">
          <option value="0">Seleccione un propietario</option>
        </select><span asp-validation-for="IdPropietario" class="text-danger"></span></div>
        <div class="mb-3"><label asp-for="IdTipo" class="form-label">Tipo</label><select asp-for="IdTipo"
                                                                                         asp-items="ViewBag.Tipos" class="form-select">
          <option value="0">Seleccione un tipo</option>
        </select><span asp-validation-for="IdTipo" class="text-danger"></span></div>
        <div class="form-check mb-3"><input asp-for="Estado" class="form-check-input" /><label asp-for="Estado"
                                                                                                 class="form-check-label">Disponible</label></div>