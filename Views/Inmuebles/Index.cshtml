@model IList<InmuebleModel>
@{
  ViewData["Title"] = "Inmuebles";
}
<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1>@ViewData["Title"]</h1>
    <a asp-action="Create" class="btn btn-primary">
      <i class="bi bi-plus-circle"></i> Nuevo inmueble
    </a>
  </div>
  @if (TempData["SuccessMessage"] is not null)
  {
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
  }
  @if (Model.Count == 0)
  {
    <div class="alert alert-info">No hay inmuebles registrados.</div>
  }
  else
  {

    <div
      class="table-responsive">
      <table class="table table-striped table-hover">
        <thead class="table-dark">
          <tr>
            <th>ID</th>
            <th>Dirección</th>
            <th>Tipo</th>
            <th>Propietario</th>
            <th>Precio</th>
            <th>Estado</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var item in Model)
          {
            <tr>
              <td>@item.Id</td>
              <td>@item.Direccion</td>
              <td>@item.NombreTipo</td>
              <td>@item.NombrePropietario</td>
              <td>@item.Precio.ToString("C")</td>
              <td>@(item.Estado ? "Disponible" : "No disponible")</td>
              <td><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Ver</a> <a asp-action="Edit"
                                                                                                           asp-route-id="@item.Id" class="btn btn-sm btn-warning">Editar</a>
                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"><button
                  class="btn btn-sm btn-danger" onclick="return confirm('¿Eliminar este inmueble?')">Eliminar</button>
                </form>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
</div>