{
  "version": "0.2.0",
  "configurations": [
    
    {
      "name": "C#: Launch Startup Project",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/PROY_INMOBILIARIA_malovini.csproj"
